# prepLens API — environment configuration
#
# Copy this file to api/.env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. This file carries names and
# shapes only — never a real secret.

# --- runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- database ----------------------------------------------------------------
# MongoDB Atlas connection string. Validated at boot, first used in Block 1.
# Atlas → Database → Connect → Drivers.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/preplens?retryWrites=true&w=majority

# --- auth --------------------------------------------------------------------
# Signs the session cookie. At least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# The only domain allowed to sign in. Enforced on every login.
COLLEGE_EMAIL_DOMAIN=nst.rishihood.edu.in

# Google OAuth credentials. OPTIONAL: without them the server still boots and
# serves the public archive; only sign-in is disabled.
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (Web application), with this Authorised redirect URI:
#   http://localhost:4000/api/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Addresses promoted to admin on login, comma-separated. Admin is a role flag
# on a normal account — never a shared login.
SUPER_ADMIN_EMAILS=

# --- origins -----------------------------------------------------------------
# The only origin allowed to send credentialed requests. No trailing slash.
FRONTEND_URL=http://localhost:5173

# This API's own public origin. Must match the Google redirect URI exactly.
API_URL=http://localhost:4000

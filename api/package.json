{
  "name": "preplens-api",
  "version": "0.1.0",
  "private": true,
  "description": "prepLens API \u2014 community-curated campus interview archive",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "indexes": "node src/scripts/indexes.js",
    "seed": "node src/scripts/seed.js",
    "test": "LOG_LEVEL=silent NODE_ENV=test node --test --test-concurrency=1 tests/*.test.js",
    "import": "node src/scripts/import.js",
    "consent": "node src/scripts/consent.js",
    "archive:reset": "node src/scripts/reset.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
